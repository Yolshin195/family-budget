{
  "name": "family-budget-web",
  "private": true,
  "type": "module",
  "description": "Сборка статики для шаблонов Askama: Tailwind CSS, htmx, шрифты, иконки Lucide, favicon. Результат коммитится в crates/app/static — для cargo run Node не нужен.",
  "scripts": {
    "css": "tailwindcss -i styles/app.css -o crates/app/static/app.css --minify",
    "css:watch": "tailwindcss -i styles/app.css -o crates/app/static/app.css --watch",
    "assets": "node scripts/build-assets.mjs",
    "build": "npm run css && npm run assets",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-thai": "5.3.0",
    "htmx.org": "2.0.11",
    "lucide-static": "1.56.0",
    "sharp": "0.35.5",
    "tailwindcss": "3.4.19",
    "puppeteer-core": "25.13.0"
  }
}
