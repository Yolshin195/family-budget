# Семейная бухгалтерия — настройки. Скопируйте в .env (он не попадает в git) и поправьте.
# Секреты — только здесь, в окружении или в файлах секретов (переменная NAME_FILE=/run/secrets/...).
# Файл читают docker compose и sh (make backup): значение с пробелами — в двойных кавычках, со знаком $ — в одинарных.

# ---------------------------------------------------------------- приложение
# dev — разработка (вход без Rauthy, Swagger, демо-данные); prod — продакшен: без секретов и HTTPS не стартует.
APP_ENV=dev
# Публичный адрес сайта без / в конце. В продакшене — только https://
APP_BASE_URL=http://localhost:8080
# Подпись CSRF-токенов и служебных cookie: случайная строка ≥ 32 символов (`openssl rand -base64 48`).
SESSION_SECRET=
# Для `cargo run` (make dev); в compose адрес БД собирается сам.
DATABASE_URL=postgres://fb_app:fb_app_dev@localhost:5432/family_budget
# Только эта машина: в dev открыт «Вход для разработки» под любым email.
BIND_ADDR=127.0.0.1:8080
APP_PORT=8080
# Демо-данные при пустой БД (только разработка; в продакшене — 0).
SEED_DEMO=1
# «Посмотреть демо» на лендинге: гость — наблюдатель демо-семьи, данные сбрасываются раз в сутки.
GUEST_DEMO=1
# Вход «для разработки» без Rauthy (в продакшене всегда выключен).
DEV_LOGIN=1
# Адрес для связи на лендинге и правовых страницах.
CONTACT_EMAIL=
# Приложение за обратным прокси: IP клиента из X-Forwarded-For.
TRUST_PROXY=0
# Запросов в минуту на сессию / API-токен.
RATE_LIMIT_PER_MIN=600

# ---------------------------------------------------------------- PostgreSQL
DB_PORT=5432
# Суперпользователь (обслуживание, резервные копии).
DB_PASSWORD=budget
# Пользователи без прав суперпользователя: приложение и Rauthy.
APP_DB_PASSWORD=fb_app_dev
RAUTHY_DB_PASSWORD=rauthy_dev

# ---------------------------------------------------------------- вход через Rauthy (OIDC)
# Issuer — ровно как в discovery Rauthy (со слешем в конце).
OIDC_ISSUER=http://localhost:8443/auth/v1/
OIDC_CLIENT_ID=family-budget
# Секрет клиента: `make rauthy-secrets` (Rauthy генерирует его при первом старте).
OIDC_CLIENT_SECRET=
# Внутренний адрес Rauthy для запросов сервера (в compose — http://rauthy:8443; при `make dev` — пусто).
OIDC_INTERNAL_URL=
# Необязательно: API-ключ Rauthy с правом Users:delete — удаление пользователя при удалении аккаунта.
# Формат: <имя>$<секрет>. Без ключа пользователь удаляет учётку в кабинете Rauthy сам.
RAUTHY_ADMIN_API_KEY=

# ---------------------------------------------------------------- Rauthy
RAUTHY_PORT=8443
# Как браузер видит Rauthy (host:port без схемы). В продакшене: auth.<домен>
RAUTHY_PUB_URL=localhost:8443
RAUTHY_ADMIN_EMAIL=admin@localhost
# Секреты кэша (≥ 16 символов): `openssl rand -hex 24`
RAUTHY_SECRET_RAFT=
RAUTHY_SECRET_API=
# Ключ шифрования: podman run --rm --entrypoint /app/rauthy ghcr.io/sebadob/rauthy:0.37.1 generate-enc-key
RAUTHY_ENC_KEYS=
RAUTHY_ENC_KEY_ACTIVE=
# Продакшен: Rauthy за прокси с TLS.
RAUTHY_PROXY_MODE=false
RAUTHY_TRUSTED_PROXIES=
RAUTHY_COOKIE_MODE=danger-insecure
RAUTHY_RP_ID=localhost
RAUTHY_RP_ORIGIN=http://localhost:8443

# Письма Rauthy (регистрация, сброс пароля, 6-значный код 2FA).
SMTP_URL=
SMTP_PORT=587
SMTP_TLS_MODE=tls
SMTP_FROM="Семейный бюджет <no-reply@example.com>"
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------------------------------------------------------------- резервные копии (scripts/backup.sh)
BACKUP_DIR=./backups
# Публичный ключ age для шифрования копий (age-keygen); без него копия не создаётся.
BACKUP_AGE_RECIPIENT=
# Хранятся три копии каждой базы: свежая, 1–6 дней и 7–12 дней назад. Порог старшей копии — от 1 до 15 дней.
BACKUP_OLD_DAYS=7
